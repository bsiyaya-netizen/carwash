DATABASE_URL=postgres://postgres:postgres@localhost:5432/carwash
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated web origins allowed to call the API. Empty = allow all (dev only).
CORS_ORIGINS=
CURRENCY=zar
# Washer's share of the (pre-tip) booking total, 0..1. Tips always go 100% to the washer.
WASHER_SHARE=0.75
# What one loyalty point is worth when redeemed, in cents (10 = 100 points for R10).
POINT_VALUE_CENTS=10

# --- Payments (leave empty for mock mode) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/webhooks/stripe` or the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Sign-in codes ------------------------------------------------------------
# Returns the code in the API response so you can sign in without SMS/email. Set false in production.
DEV_RETURN_LOGIN_CODE=true
SMS_PROVIDER=console          # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                  # a Twilio number or Messaging Service SID (MG...)
EMAIL_PROVIDER=console        # console | resend
RESEND_API_KEY=
EMAIL_FROM=Sparkle Wash <no-reply@yourdomain.com>

# --- Social sign-in -----------------------------------------------------------
# Google OAuth client IDs (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=
# Apple: iOS bundle ID, plus the Services ID if you enable Apple sign-in on the website.
APPLE_AUDIENCES=com.example.carwash.customer
