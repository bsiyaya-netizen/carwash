DATABASE_URL=postgres://postgres:postgres@localhost:5432/carwash
PORT=4000
JWT_SECRET=change-me
CURRENCY=zar
# Washer's share of the (pre-tip) booking total, 0..1. Tips always go 100% to the washer.
WASHER_SHARE=0.75
# Leave empty to run payments in mock mode.
STRIPE_SECRET_KEY=
# In dev the login code is returned in the API response and logged. Set to "false" once an SMS provider is wired up.
DEV_RETURN_LOGIN_CODE=true
